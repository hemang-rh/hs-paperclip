# Compose isolation — change these to run multiple stacks side by side.
COMPOSE_PROJECT_NAME=paperclip-local
PAPERCLIP_HOST_PORT=3100

# Paperclip server
DATABASE_URL=postgres://paperclip:paperclip@db:5432/paperclip
PORT=3100
SERVE_UI=true
PAPERCLIP_HOME=/paperclip
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_CONFIG=/paperclip/instances/default/config.json
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_MIGRATION_AUTO_APPLY=true
PAPERCLIP_DB_BACKUP_ENABLED=false
HEARTBEAT_SCHEDULER_ENABLED=true

# Fixed 32-byte secrets for reproducible local restarts (NOT for production).
BETTER_AUTH_SECRET=8164feefd985ddbb4302bd11b8ce72f93bda99326fd62f8e8d60f81664f0fa94
PAPERCLIP_SECRETS_MASTER_KEY=K3oMT2/aSzp4qiHmMwaHMGmSpzgsnrubhMkhEd2Yo3Q=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=d9bc0413a8add0e8182a5045d5c6e1e9d64568b94824e60b3d5ecf2f457de5d2
PAPERCLIP_AGENT_JWT_SECRET=6fc8eb04e1c40696ab5807cfa63d2ea09b547b66ab9bcdaa02fd58c2873e4a91

# S3 storage via MinIO (local stand-in for GCS)
PAPERCLIP_STORAGE_PROVIDER=s3
PAPERCLIP_STORAGE_S3_BUCKET=paperclip-uploads
PAPERCLIP_STORAGE_S3_REGION=us-east-1
PAPERCLIP_STORAGE_S3_ENDPOINT=http://minio:9000
PAPERCLIP_STORAGE_S3_FORCE_PATH_STYLE=true
PAPERCLIP_STORAGE_S3_PREFIX=uploads
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Optional — required only if you want agents to actually run (claude_local / etc.).
# Without these, the UI and API work, but agent runs fail with "Authentication required".
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
